---
import { CATEGORY_LABELS } from '../data/categories.js';
import { SITE_URL } from '../config/site.js';
import { extractYouTubeId, getStructuredOffer } from '../utils/format.js';

interface Props {
  robot: Record<string, string>;
}

const { robot } = Astro.props;

const name = `${robot.manufacturer} ${robot.model}`;
const catLabel = CATEGORY_LABELS[robot.category] || robot.category;
const description =
  robot.description && robot.description.trim() && robot.description !== 'N/A'
    ? `${name} - ${catLabel}: ${robot.description}`
    : `${name} - ${catLabel} by ${robot.manufacturer}. View specs, images and compare with other robots.`;
const url = `${SITE_URL}/robot/${robot.id}/`;

const imageUrl =
  robot.image && robot.image !== 'images/image-not-found.webp'
    ? `${SITE_URL}/${robot.image.replace(/^\//, '')}`
    : undefined;

// Build JSON-LD
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name,
  description,
  category: catLabel,
  brand: { '@type': 'Organization', name: robot.manufacturer },
  url,
};
if (imageUrl) jsonLd.image = imageUrl;
if (robot.website) jsonLd.sameAs = robot.website;

// Expose key specs as structured product properties
const SPEC_PROPS: Array<{ key: string; name: string }> = [
  { key: 'weight', name: 'Weight' },
  { key: 'size', name: 'Size' },
  { key: 'batteryLife', name: 'Battery life' },
  { key: 'maxRuntime', name: 'Max runtime' },
  { key: 'chargingTime', name: 'Charging time' },
  { key: 'depthRating', name: 'Depth rating' },
  { key: 'flightTime', name: 'Flight time' },
  { key: 'maxTakeoffWeight', name: 'Maximum takeoff mass' },
  { key: 'cookingCapacity', name: 'Cooking capacity per batch' },
  { key: 'heatSource', name: 'Heat source' },
  { key: 'workingWidth', name: 'Working width' },
  { key: 'areaRate', name: 'Area rate' },
  { key: 'throughput', name: 'Throughput' },
  { key: 'stackingHeight', name: 'Stacking height' },
  { key: 'assistPower', name: 'Assistance power' },
  { key: 'assistancePace', name: 'Assistance pace' },
  { key: 'assistanceRange', name: 'Assistance range' },
  { key: 'waterTankCapacity', name: 'Water tank capacity' },
  { key: 'navigationAccuracy', name: 'Navigation accuracy' },
  { key: 'dockingAccuracy', name: 'Docking accuracy' },
  { key: 'driveMode', name: 'Drive mode' },
  { key: 'liftStroke', name: 'Lift travel' },
  { key: 'maxLiftHeight', name: 'Maximum fork height' },
  { key: 'armReach', name: 'Arm reach' },
  { key: 'armRepeatability', name: 'Arm repeatability' },
  { key: 'weldSpeed', name: 'Welding feed rate' },
  { key: 'workTableSize', name: 'Work table dimensions' },
  { key: 'minAisleWidth', name: 'Minimum aisle width' },
  { key: 'turningRadius', name: 'Turning radius' },
  { key: 'transportPayload', name: 'Transport payload' },
  { key: 'visionPrecision', name: 'Vision localization precision' },
  { key: 'dof', name: 'Degrees of freedom' },
  { key: 'payload', name: 'Payload' },
  { key: 'speed', name: 'Speed' },
  { key: 'ipRating', name: 'IP rating' },
  { key: 'terrain', name: 'Terrain' },
];
const additionalProperty = SPEC_PROPS.filter(
  ({ key }) => robot[key] && robot[key].trim() && !robot[key].trim().startsWith('N/A'),
).map(({ key, name: propName }) => ({
  '@type': 'PropertyValue',
  name: propName,
  value: robot[key].trim(),
}));
if (additionalProperty.length > 0) jsonLd.additionalProperty = additionalProperty;

const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
    {
      '@type': 'ListItem',
      position: 2,
      name: catLabel,
      item: `${SITE_URL}/category/${robot.category}/`,
    },
    { '@type': 'ListItem', position: 3, name, item: url },
  ],
};

// Historical, estimated, starting and preorder prices remain qualified text.
const offer = getStructuredOffer(robot.price);
if (offer) jsonLd.offers = offer;

// VideoObject structured data for embedded YouTube demos
const videoId = extractYouTubeId(robot.video);
const videoLd = videoId
  ? {
      '@context': 'https://schema.org',
      '@type': 'VideoObject',
      name,
      description,
      thumbnailUrl: `https://i.ytimg.com/vi/${videoId}/maxresdefault.jpg`,
      embedUrl: `https://www.youtube.com/embed/${videoId}`,
      contentUrl: `https://www.youtube.com/watch?v=${videoId}`,
      uploadMode: 'PROGRESSIVE',
    }
  : null;
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
<script
  type="application/ld+json"
  set:html={JSON.stringify(breadcrumbLd).replace(/</g, '\\u003c')}
/>
{
  videoLd && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(videoLd).replace(/</g, '\\u003c')}
    />
  )
}
